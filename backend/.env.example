# Ollama open-source LLM (auto-detects if running)
OLLAMA_ENABLED=auto
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# Set OLLAMA_ENABLED=false to force rule-based only

# Google Calendar + Meet (optional — demo mode if unset)
# ADVISOR_EMAIL=harish@yourdomain.com
# GOOGLE_CALENDAR_CREDENTIALS_FILE=/path/to/service-account.json
# GOOGLE_CALENDAR_DELEGATE_EMAIL=harish@yourdomain.com
# GOOGLE_CALENDAR_ID=primary

# Google Form webhook (Apps Script → POST /api/webhooks/form-intake)
FORM_WEBHOOK_SECRET=dev-form-secret
